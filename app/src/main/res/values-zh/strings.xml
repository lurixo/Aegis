    <string name="layout_alpha">全拼 26 键</string>

    <string name="user_dict_title">学习词库</string>
    <string name="user_dict_description">Aegis 会离线学习你常用的词与下一个词，存为【学习词库】（只存本机）。这与你下载的【主词库】（拼音大词库）是两份独立的库 —— 这里的导入/覆盖只动学习词库，绝不影响主词库。导入立即生效。</string>
    <string name="user_dict_default_path_format">默认词库：%1$s（应用私有目录，文件管理器不可见 → 用“导出”取出副本，默认文件名 aegis-userdb.txt）。</string>
    <string name="user_dict_export_button">导出学习词库</string>
    <string name="user_dict_import_button">导入学习词库</string>
    <string name="user_dict_toast_import_merged">已合并导入学习词库</string>
    <string name="user_dict_toast_import_overwritten">已覆盖导入学习词库</string>
    <string name="user_dict_toast_import_failed">导入失败：文件无法读取或无有效词条，词库未改动</string>
    <string name="user_dict_import_dialog_title">导入学习词库</string>
    <string name="user_dict_import_dialog_body">这里导入/导出的是【学习词库】（userdb.txt — 本机学习到的词与词频），不是你下载的【主词库】（拼音大词库）。「合并」把导入内容累加到现有学习词库（去重、词频相加，保留历史）；「覆盖」用导入文件整体替换【学习词库】（不影响已下载的主词库）。</string>
    <string name="user_dict_import_merge">合并（推荐）</string>
    <string name="user_dict_import_overwrite">覆盖</string>
    <string name="user_dict_manual_title">我的词</string>
    <string name="user_dict_manual_description">添加一个词和它的拼音，输入该拼音时就会作为候选出现；也可删除某个词，让它不再出现在候选里。逐字拼出的词会自动加到这里。改动立即生效。</string>
