    <string name="fuzzy_card_title">模糊拼音</string>
    <string name="fuzzy_master_title">模糊拼音（总开关）</string>
    <string name="fuzzy_master_description">容忍常见拼音混淆；可逐项单独开关。改动立即生效。</string>
