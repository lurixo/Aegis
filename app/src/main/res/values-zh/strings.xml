    <string name="fuzzy_rule_eng_desc">前后鼻音：冷=（len）</string>
    <string name="fuzzy_rule_ing_title">ing → in</string>
    <string name="fuzzy_rule_ing_desc">前后鼻音：心=星、林=灵</string>
