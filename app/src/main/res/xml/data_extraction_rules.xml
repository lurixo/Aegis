<?xml version="1.0" encoding="utf-8"?>
<!-- The user dictionary is private and offline; exclude all app data from cloud backup / transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
