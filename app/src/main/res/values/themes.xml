<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aegis" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- B6: paint the starting/transition window with the resolved theme background so returning to the
             app from another app no longer flashes the default (white/black) window background before
             Compose draws. DayNight-aware via the attr, so dark mode stays dark. -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="Theme.Aegis.Transparent" parent="Theme.Aegis">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Aegis.None</item>
    </style>

    <style name="Animation.Aegis.None" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/aegis_no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskOpenEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskOpenExitAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskCloseEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskCloseExitAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskToFrontEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskToFrontExitAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskToBackEnterAnimation">@anim/aegis_no_animation</item>
        <item name="android:taskToBackExitAnimation">@anim/aegis_no_animation</item>
    </style>
</resources>
