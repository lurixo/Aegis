    <string name="setup_title">Aegis IME</string>
    <string name="setup_summary">Chinese / English input method. Self-built Pinyin engine (full Pinyin and T9), fuzzy Pinyin, abbreviated Pinyin, mixed Chinese/English input, offline self-learning, and optional Wanxiang model enhancement. The Chinese dictionary is downloaded after install; once installed, all input runs offline.</string>
    <string name="setup_first_run_title">First use</string>
    <string name="setup_first_run_body">Chinese input needs a one-time dictionary download, and Aegis never starts it by itself. When you type pinyin with no dictionary installed, the candidate bar shows a download prompt; tap it to start, or use the dictionary settings below. English typing works offline right away. Downloaded data is stored locally only.</string>
    <string name="setup_first_run_ack">Got it</string>
