    <string name="user_dict_title">Learning dictionary</string>
    <string name="user_dict_description">Aegis learns your frequent words and next-word pairs offline and stores them as the learning dictionary on this device. This is separate from the downloaded main dictionary: import/overwrite here only changes the learning dictionary and never changes the main dictionary. Imports take effect immediately.</string>
    <string name="user_dict_default_path_format">Default dictionary: %1$s (app-private directory, hidden from file managers; use Export to copy it out. Default file name: aegis-userdb.txt).</string>
    <string name="user_dict_export_button">Export learning dictionary</string>
    <string name="user_dict_import_button">Import learning dictionary</string>
