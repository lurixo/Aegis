    <string name="user_dict_toast_import_overwritten">Learning dictionary imported and overwritten</string>
    <string name="user_dict_toast_import_failed">Import failed: file cannot be read or has no valid entries; dictionary was not changed</string>
    <string name="user_dict_import_dialog_title">Import learning dictionary</string>
    <string name="user_dict_import_dialog_body">This imports/exports the learning dictionary (userdb.txt - words and frequencies learned on this device), not the downloaded main dictionary. Merge adds imported entries to the current learning dictionary with dedupe and accumulated frequencies. Overwrite replaces the learning dictionary with the imported file. Neither option changes the downloaded main dictionary.</string>
    <string name="user_dict_import_merge">Merge (recommended)</string>
    <string name="user_dict_import_overwrite">Overwrite</string>
